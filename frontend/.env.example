# Frontend environment variables (copy to `.env` for local development).
# Vite only exposes variables prefixed with VITE_ to the browser bundle,
# so nothing secret belongs here.

# Base URL of the PAIMANA backend API (required by src/services/api.js).
# The Express backend defaults to port 3000; point this at your instance.
VITE_API_URL=http://localhost:5000/api
